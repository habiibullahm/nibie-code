# Copy this file to .env.local and fill these values from the Nibie Supabase project.
NEXT_PUBLIC_APP_NAME=Nibie
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefer the publishable key. Older Supabase projects may use the public anon-key variable instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key name (use one public key variable only):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by Drizzle migrations only. Keep this database credential server-side.
DATABASE_URL=

# Server-only Supabase service role for Action audit RPCs (insert_action_run / complete_action_run).
# Never put this in NEXT_PUBLIC_*. Ordinary user routes still use the publishable key + user JWT.
# SUPABASE_SERVICE_ROLE_KEY=

# Integration tests destructively reset only a loopback database named nibie_ai.
TEST_DATABASE_URL=
# Explicit opt-in required before the RLS integration test resets its local database.
ALLOW_TEST_DATABASE_RESET=

# Server-only AI provider configuration. Never expose these values to the browser.
# Fast: Sumopod gateway running DeepSeek V4.1 Flash. (The earlier AI_BASE_URL / AI_API_KEY names still work as a fallback.)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=
# Optional override of the Fast model id (default deepseek-v4.1-flash:netra):
# SUMOPOD_MODEL_FAST=
# Balanced (GPT-6 Luna) and High (GPT-6.1 Sol) call OpenAI directly. Without OPENAI_API_KEY only Fast is offered.
OPENAI_API_KEY=
# Optional: HTTPS base URL of an OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=
# Optional model id overrides:
# OPENAI_MODEL_BALANCED=gpt-6-luna
# OPENAI_MODEL_HIGH=gpt-6.1-sol
# Optional reasoning effort per mode: low, medium or high. High always sends one (high when unset). Balanced sends one only when set; Fast never does.
# OPENAI_BALANCED_REASONING_EFFORT=medium
# OPENAI_HIGH_REASONING_EFFORT=high

# AI Cost & Usage Guard — dollar ceilings (distinct from weekly free credits).
# Unset uses defaults ($5/user/day, $50/global/hour). Explicit 0 fails closed (blocks generations).
# AI_SPEND_LIMIT_USER_DAILY_USD=5
# AI_SPEND_LIMIT_GLOBAL_HOURLY_USD=50
# Cron auth for POST /api/cron/reconcile-usage (Bearer). Required for failure-safe quota reconcile.
# CRON_SECRET=

# Optional web search (server-only). When unset, chat continues without web context.
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# Optional bound overrides (defaults: 8 results, 4 pages, 5 sources):
# WEB_SEARCH_MAX_RESULTS=8
# WEB_FETCH_MAX_PAGES=4
# WEB_CONTEXT_MAX_SOURCES=5

# Optional GitHub Read Actions (server-only). Public repositories only — private repos are always rejected.
# Dogfood defaults to unauthenticated public reads. Never log or store credentials in action_runs.
# GITHUB_TOKEN=
# Set true only to attach GITHUB_TOKEN for higher public rate limits (still public-only):
# GITHUB_READ_USE_TOKEN=true
# Optional overrides (non-api.github.com hosts are ignored):
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_API_TIMEOUT_MS=12000

# Dedicated test account; never use a real user's credentials for automated tests.
# npm run test:e2e skips credential specs when these are unset.
# npm run test:qa:smoke, npm run test:qa:preview, and npm run test:chat:e2e require them and fail if missing.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional deployed target for low-level smoke; without this, Playwright uses the local default base URL.
# npm run test:qa:preview sets E2E_BASE_URL automatically for the child process (exact HEAD preview).
E2E_BASE_URL=
# Protected Vercel previews use the short-lived VERCEL_OIDC_TOKEN injected by `vc env run`.
# npm run test:qa:preview needs VERCEL_TOKEN (or an authenticated Vercel CLI) to list deployments.
# Cloud Agents may also set VERCEL_ORG_ID + VERCEL_PROJECT_ID to bootstrap gitignored .vercel/project.json
# without interactive `vercel link`. Never paste or persist tokens in this file.
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# Fastify foundation (apps/api). These names are not read by Next.js.
# The foundation process does not receive production traffic.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# APP_ORIGINS=
# API_HOST=127.0.0.1
# API_PORT=4000
# LOG_LEVEL=info
